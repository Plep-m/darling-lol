+@interface NWConcrete_nw_path_monitor : NSObject {
+@public
+	dispatch_queue_t queue;
+	void (^update_handler)(nw_path_t);
+	void (^cancel_handler)(void);
+	bool started, cancelled;
+}
+@end
+
+@implementation NWConcrete_nw_path_monitor
+- (void)dealloc
+{
+	if (queue) dispatch_release(queue);
+	if (update_handler) Block_release(update_handler);
+	if (cancel_handler) Block_release(cancel_handler);
+	[super dealloc];
+}
+@end
+
+id nw_path_monitor_create(void)
+{
+	return [[NWConcrete_nw_path_monitor alloc] init];
+}
+
+id nw_path_monitor_create_with_type(int required_interface_type)
+{
+	(void)required_interface_type;
+	return nw_path_monitor_create();
+}
+
+void nw_path_monitor_prohibit_interface_type(id monitor, int interface_type)
+{
+	(void)monitor; (void)interface_type;
+}
+
+void nw_path_monitor_set_queue(id monitor, dispatch_queue_t queue)
+{
+	NWConcrete_nw_path_monitor* m = monitor;
+	if (m == nil) return;
+	if (queue) dispatch_retain(queue);
+	if (m->queue) dispatch_release(m->queue);
+	m->queue = queue;
+}
+
+void nw_path_monitor_set_update_handler(id monitor, void (^update_handler)(nw_path_t path))
+{
+	NWConcrete_nw_path_monitor* m = monitor;
+	if (m == nil) return;
+	if (m->update_handler) Block_release(m->update_handler);
+	m->update_handler = update_handler ? Block_copy(update_handler) : NULL;
+}
+
+void nw_path_monitor_set_cancel_handler(id monitor, void (^cancel_handler)(void))
+{
+	NWConcrete_nw_path_monitor* m = monitor;
+	if (m == nil) return;
+	if (m->cancel_handler) Block_release(m->cancel_handler);
+	m->cancel_handler = cancel_handler ? Block_copy(cancel_handler) : NULL;
+}
+
+void nw_path_monitor_start(id monitor)
+{
+	NWConcrete_nw_path_monitor* m = monitor;
+	if (m == nil || m->started || m->queue == NULL) return;
+	m->started = true;
+	[m retain];
+	dispatch_async(m->queue, ^{
+		if (!m->cancelled && m->update_handler) {
+			NWConcrete_nw_path* path = [[NWConcrete_nw_path alloc] init];
+			m->update_handler((nw_path_t)path);
+			[path release];
+		}
+		[m release];
+	});
+}
+
+void nw_path_monitor_cancel(id monitor)
+{
+	NWConcrete_nw_path_monitor* m = monitor;
+	if (m == nil || m->cancelled) return;
+	m->cancelled = true;
+	if (m->cancel_handler && m->queue) {
+		void (^handler)(void) = Block_copy(m->cancel_handler);
+		dispatch_async(m->queue, ^{
+			handler();
+			Block_release(handler);
+		});
+	}
+}
